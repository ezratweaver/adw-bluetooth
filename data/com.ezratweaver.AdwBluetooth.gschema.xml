<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="adw-bluetooth">
	<schema id="com.ezratweaver.AdwBluetooth" path="/com/ezratweaver/AdwBluetooth/">

    <key name="device-history" type="a{ou}">
      <default>{}</default>
    </key>

    <key name="last-used-adapter" type="s">
      <default>""</default>
      <summary>Last used Bluetooth adapter</summary>
      <description>Path of the last used Bluetooth adapter to restore on startup</description>
    </key>

    <key name="shortcut-move-down" type="s">
      <default>"j"</default>
      <summary>Shortcut: Move down</summary>
    </key>

    <key name="shortcut-move-up" type="s">
      <default>"k"</default>
      <summary>Shortcut: Move up</summary>
    </key>

    <key name="shortcut-first" type="s">
      <default>"g"</default>
      <summary>Shortcut: Go to first device</summary>
    </key>

    <key name="shortcut-last" type="s">
      <default>"&lt;Shift&gt;g"</default>
      <summary>Shortcut: Go to last device</summary>
    </key>

    <key name="shortcut-page-down" type="s">
      <default>"&lt;Control&gt;d"</default>
      <summary>Shortcut: Half page down</summary>
    </key>

    <key name="shortcut-page-up" type="s">
      <default>"&lt;Control&gt;u"</default>
      <summary>Shortcut: Half page up</summary>
    </key>

    <key name="shortcut-toggle-discovery" type="s">
      <default>"d"</default>
      <summary>Shortcut: Toggle discovery mode</summary>
    </key>

	</schema>
</schemalist>